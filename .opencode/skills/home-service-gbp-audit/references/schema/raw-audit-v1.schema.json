{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thatguynef.github.io/gbp-scorecard/schema/raw-audit-v1.schema.json",
  "title": "GBP Scorecard raw collector output (public mode, v1)",
  "description": "A non-scored worksheet. The collector never invents unavailable facts. A reviewer must fill checks and facts before score.py will accept the audit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_mode", "run", "business", "configuration", "sources", "observations", "review", "checks"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "audit_mode": { "const": "public" },
    "run": {
      "type": "object",
      "required": ["run_id", "started_at", "collector_version", "rubric_version", "source_mode", "synthetic"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "finished_at": { "type": "string" },
        "collector_version": { "type": "string", "minLength": 1 },
        "rubric_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source_mode": { "enum": ["fixture", "live"] },
        "synthetic": { "type": "boolean" }
      }
    },
    "business": {
      "type": "object",
      "required": ["name", "trade", "market"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "trade": { "type": "string", "minLength": 1 },
        "market": { "type": "string", "minLength": 1 },
        "place_id": { "type": "string" },
        "website": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "configuration": { "type": "object" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "observations": {
      "type": "object",
      "required": ["profile", "actions", "handoff", "reviews", "media", "measurement"],
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["status", "notes"],
      "properties": {
        "status": { "enum": ["pending"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^GBP-(?:ID|SVC|CON|TRU|CNT|HND|MSR)-[0-9]{2}$" },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["applicable", "score", "confidence", "needs_review", "evidence", "evidence_refs"],
            "properties": {
              "applicable": { "type": ["boolean", "null"] },
              "score": { "type": "null" },
              "confidence": { "const": "needs_review" },
              "needs_review": { "const": true },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "evidence_refs": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          },
          {
            "type": "object",
            "required": ["applicable", "score", "confidence", "needs_review", "na_reason"],
            "properties": {
              "applicable": { "const": false },
              "score": { "type": "null" },
              "confidence": { "const": "not_applicable" },
              "needs_review": { "const": false },
              "na_reason": { "type": "string", "minLength": 1 },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "evidence_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        ]
      }
    }
  }
}
