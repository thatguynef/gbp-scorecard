{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thatguynef.github.io/gbp-scorecard/schema/judgment-v1.schema.json",
  "title": "GBP Scorecard judgment proposal (v1)",
  "description": "A model or reviewer proposal for judgment-only checks. Deterministic checks, owner-data questions, and free-form scores are rejected by apply_judgment.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_mode", "model", "checks"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "audit_mode": { "const": "public" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "version": { "type": "string" },
        "reviewed_at": { "type": "string" }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^GBP-(?:ID|SVC|CON|TRU|CNT|HND|MSR)-[0-9]{2}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score", "confidence", "evidence", "evidence_refs"],
        "properties": {
          "score": { "type": "integer", "minimum": 0, "maximum": 4 },
          "confidence": { "enum": ["verified", "strong_signal"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
