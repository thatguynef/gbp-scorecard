# Copy to .env only if your local tooling loads dotenv files.
# This repository never reads .env automatically. Export these in your shell.
# Never put a real value in this tracked file.

# Public Places API (New) key, restricted to the Places API.
GOOGLE_MAPS_API_KEY=

# Connected / authorized mode is not implemented in V1.
# These names are reserved so future OAuth work never invents new configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional live collector controls (safe defaults are in code).
# GBP_PLACES_TIMEOUT_MS=10000
# GBP_DESTINATION_TIMEOUT_MS=10000
